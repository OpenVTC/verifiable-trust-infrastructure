# =============================================================================
# VTA Nitro Enclave Image
# =============================================================================
#
# Multi-stage build that produces a minimal image for AWS Nitro Enclaves
# with full REST + DIDComm support via vsock proxying.
#
# Usage:
#   docker build -f Dockerfile.nitro -t vta-nitro .
#   nitro-cli build-enclave --docker-uri vta-nitro --output-file vta.eif
#
# Networking: Nitro Enclaves have NO direct network access. The VTA serves
# inbound REST on vsock itself (VTA_REST_VSOCK_PORT, parent only); the
# entrypoint starts socat-based vsock proxies for the outbound channels.
# The parent EC2 instance runs parent-proxy.sh to bridge vsock<->internet.
#
# CONFIG MODES (BAKE_CONFIG build-arg):
#   BAKE_CONFIG=true  (DEFAULT) — bake deploy/nitro/config.toml into the image.
#       Best for single-tenant / self-hosted deploys: the config is committed to
#       PCR0 and fully attested, and the binary contains NO vsock config-fetch
#       code (the `tenant-overlay` feature is not compiled in).
#   BAKE_CONFIG=false — bake a fleet-policy BASE config with placeholders for the
#       tenant-scoped fields, so ONE image / ONE PCR0 serves every tenant
#       (multi-tenant operators, e.g. a managed VTA fleet). The binary is built
#       with the `tenant-overlay` feature: at boot it fetches a typed,
#       allowlisted overlay from the parent over vsock:5800 and applies it onto
#       the baked base. See docs/05-design-notes/tenant-config-allowlist.md and
#       deploy/nitro/enclave-entrypoint.sh.
#
# CACHING, two separate mechanisms — both load-bearing:
#
#  1. Dependencies are cached with cargo-chef. `prepare` distils the workspace
#     into a recipe.json of just the dependency graph; `cook` builds that. The
#     expensive layer is keyed on the recipe, so it survives every source edit
#     and is rebuilt only when a dependency actually moves. This replaces the
#     older manifests-plus-dummy-sources trick, which hand-maintained the
#     workspace member list three times over — including one copy that had to
#     get each crate's target kind right (bin vs lib vs both) — and warmed the
#     cache under `|| true`, so getting it wrong was silent: you got a
#     full-from-scratch dependency rebuild on every build with nothing saying
#     why. Adding a crate to the workspace no longer requires an edit there.
#
#  2. config.toml is copied ONLY in Stage 3 (runtime), so editing
#     deploy/nitro/config.toml re-layers just the tiny Alpine stage and does
#     NOT invalidate the Rust build. This is why Stage 2 still copies the
#     workspace crates explicitly instead of `COPY . .` — that one list is
#     deliberate, and the reason it cannot be dropped. (`COPY --exclude=deploy`
#     would express it directly, but needs Dockerfile syntax 1.19, i.e. pulling
#     a frontend image from Docker Hub at build time. Not worth a new network
#     dependency and a new variable in layer construction for an image whose
#     PCR measurements are attestation-critical.)
#     The planner in Stage 1 may `COPY . .` freely: deploy/ does not affect
#     recipe.json, so the byte-identical recipe keeps Stage 2's cook layer warm.
# =============================================================================

# BASE IMAGES ARE PINNED BY DIGEST (#2653), every `FROM` as `image:tag@sha256:…`.
# A tag is a name a registry may point at new content at any time, so with
# tags alone two builds of one commit could start from different bytes. The
# tag stays for the reader and for Dependabot (docker ecosystem), which moves
# tag and digest together in one pull request. The Rust version is written in
# the `FROM` line rather than an ARG for the same reason: Dependabot does not
# resolve an ARG-interpolated image. Keep it equal to rust-toolchain.toml
# (scripts/check-toolchain-pins.sh warns when they drift).
#
# The runtime stage feeds PCR0, the enclave's attestation anchor (`pnm
# bootstrap connect --expect-pcr0`, the KMS key policy), so for this image the
# Alpine packages are pinned too; see Stage 3.
# Pinned: cargo-chef's recipe format is tied to its version, and an unpinned
# `cargo install` would silently change the dependency-cache key across builds.
ARG CARGO_CHEF_VERSION=0.1.78

# BAKE_CONFIG selects whether config.toml is baked into the final image (see
# CONFIG MODES above). Declared before the first FROM so it can drive the config
# selector stage below; re-declared inside the stages that consume it.
ARG BAKE_CONFIG=true

# ---------------------------------------------------------------------------
# Stage 0: toolchain + cargo-chef (shared base for planner and builder)
# ---------------------------------------------------------------------------
FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS chef
ARG CARGO_CHEF_VERSION
RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
WORKDIR /build

# ---------------------------------------------------------------------------
# Stage 1: plan — reduce the workspace to its dependency graph
# ---------------------------------------------------------------------------
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ---------------------------------------------------------------------------
# Stage 2: Build the VTA enclave binary
# ---------------------------------------------------------------------------
FROM chef AS builder

# Install build dependencies (dbus-1 is required by the keyring crate's build script)
RUN apt-get update && \
    apt-get install -y --no-install-recommends libdbus-1-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Feature flags for the VTA enclave build.
# Override with: docker build --build-arg FEATURES="didcomm,vsock-store" ...
#
# Profiles (vsock-store and vsock-log are always included):
#   Hardened (DIDComm only):  didcomm,vsock-store,vsock-log
#   Full API (REST+DIDComm):  rest,didcomm,vsock-store,vsock-log
#   REST only:                rest,vsock-store,vsock-log
#
# TEE support is built into vta-enclave by default (no need to specify tee).
# KMS bootstrap handles seed and JWT key — no need for config-seed, keyring,
# or aws-secrets features.
ARG FEATURES="rest,didcomm,vsock-store,vsock-log"

# BAKE_CONFIG drives one Rust feature: the fleet build (`false`) compiles in the
# `tenant-overlay` vsock config-fetch path; the baked build (`true`) does not, so
# a self-host binary contains no config-fetch code at all. Re-declared here so
# the builder stage can read the global ARG.
ARG BAKE_CONFIG=true


# Dependency layer. No `--locked` here: cook builds from the recipe rather than
# the real manifests, and the flag buys nothing for a warm-up whose output is
# discarded. The real build below is locked, which is where it matters.
COPY --from=planner /build/recipe.json recipe.json
RUN EFFECTIVE_FEATURES="${FEATURES}"; \
    if [ "${BAKE_CONFIG}" = "false" ]; then EFFECTIVE_FEATURES="${EFFECTIVE_FEATURES},tenant-overlay"; fi; \
    cargo chef cook --release --recipe-path recipe.json \
        --package vta-enclave \
        --no-default-features --features "${EFFECTIVE_FEATURES}"

# Real sources — every workspace member EXCEPT deploy/, whose config.toml is
# baked in Stage 3. See the CACHING note at the top: `COPY . .` here would pull
# deploy/nitro/config.toml into this layer and make every config edit trigger a
# Rust rebuild. A member missing from this list keeps cargo-chef's skeleton
# stub instead of its real source, which fails the build below rather than
# silently producing a broken binary.
COPY Cargo.toml Cargo.lock ./
COPY cnm-cli/ cnm-cli/
COPY didcomm-test/ didcomm-test/
COPY pnm-cli/ pnm-cli/
COPY room-host/ room-host/
COPY tests/ tests/
COPY vta-cli-common/ vta-cli-common/
COPY vta-config/ vta-config/
COPY vta-keyspaces/ vta-keyspaces/
COPY vta-audit/ vta-audit/
COPY vta-backup/ vta-backup/
COPY vta-keys/ vta-keys/
COPY vta-policy/ vta-policy/
COPY vta-mcp/ vta-mcp/
COPY vta-mobile-core/ vta-mobile-core/
COPY vta-persona/ vta-persona/
COPY vta-sdk/ vta-sdk/
COPY vta-support/ vta-support/
COPY vta-tee/ vta-tee/
COPY vta-sweepers/ vta-sweepers/
COPY vta-vault/ vta-vault/
COPY vta-external/ vta-external/
COPY vta-webvh/ vta-webvh/
COPY vta-service/ vta-service/
COPY vta-enclave/ vta-enclave/
COPY vtc-audit/ vtc-audit/
COPY vtc-client/ vtc-client/
COPY vtc-service/ vtc-service/
COPY vtc-mcp/ vtc-mcp/
COPY vti-common/ vti-common/
COPY vti-mcp-common/ vti-mcp-common/
COPY vti-rooms/ vti-rooms/
COPY vti-rooms-dtg/ vti-rooms-dtg/
COPY vti-rooms-wasm/ vti-rooms-wasm/
COPY vti-secrets/ vti-secrets/
COPY vti-specs/ vti-specs/
COPY vti-specs-core/ vti-specs-core/
COPY vti-specs-rooms/ vti-specs-rooms/
COPY vti-specs-vta/ vti-specs-vta/
COPY vti-specs-vtc/ vti-specs-vtc/
COPY vti-specs-vtn/ vti-specs-vtn/
COPY vti-trust-task-server/ vti-trust-task-server/
COPY vti-oob-server/ vti-oob-server/
COPY vti-vetting-pcs/ vti-vetting-pcs/
COPY vti-voting/ vti-voting/
COPY vti-voting-service/ vti-voting-service/
COPY vti-vtn/ vti-vtn/
COPY vti-webauthn/ vti-webauthn/
COPY vti-witness/ vti-witness/

# Build the VTA enclave binary with selected feature flags. `--locked` so the
# image cannot silently resolve a dependency set other than the one CI tested.
# `tenant-overlay` is appended for the fleet build (BAKE_CONFIG=false) so the
# baked base config's placeholder fields are filled from the vsock overlay.
RUN EFFECTIVE_FEATURES="${FEATURES}"; \
    if [ "${BAKE_CONFIG}" = "false" ]; then EFFECTIVE_FEATURES="${EFFECTIVE_FEATURES},tenant-overlay"; fi; \
    echo "Building vta-enclave (BAKE_CONFIG=${BAKE_CONFIG}) with features: ${EFFECTIVE_FEATURES}"; \
    cargo build --release --locked --package vta-enclave \
        --no-default-features --features "${EFFECTIVE_FEATURES}"

# Build a tiny stub for __res_init — an obsolete glibc resolver function
# that musl/Alpine don't provide. Returning 0 (success) is safe; modern
# DNS resolution uses different code paths.
RUN echo 'int __res_init(void) { return 0; }' > /tmp/res_stub.c && \
    gcc -shared -nostartfiles -o /tmp/libresolv_compat.so /tmp/res_stub.c

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Config selector: pick a source of `/out` for the runtime stage based on the
# BAKE_CONFIG build-arg. This is the BuildKit-safe way to make the config COPY
# conditional — the runtime stage always copies `/out/`, but its contents differ:
#   - config-true:  /out/config.toml = the full tenant config (committed to PCR0)
#   - config-false: /out/config.toml = a fleet-policy BASE with placeholders for
#                   the tenant-scoped fields; the enclave overlays the real
#                   values at boot over vsock (see the tenant-overlay feature).
# Both stages exist so `COPY --from=config-src /out/` always has a valid source,
# and either way the runtime image ships a config.toml (the fleet base carries
# the baked, PCR0-committed fleet policy: mode=required, allow_* defaults, and
# tee.allowed_kms_accounts — none of which the overlay can weaken).
# ---------------------------------------------------------------------------
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS config-true
RUN mkdir -p /out
COPY deploy/nitro/config.toml /out/config.toml

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS config-false
RUN mkdir -p /out
COPY deploy/nitro/config.fleet-base.toml /out/config.toml
# Bake the PCR0-committed account allowlist from a build-arg into the COPIED file
# (never the tracked source), so repeated builds for different accounts are
# reproducible. Value is the JSON-array inner text, e.g. `"111122223333"` or
# `"111122223333","444455556666"`. Empty leaves the placeholder (fail-closed).
ARG ALLOWED_KMS_ACCOUNTS=""
RUN if [ -n "${ALLOWED_KMS_ACCOUNTS}" ]; then \
        sed -i "s|allowed_kms_accounts = \[\"REPLACE_WITH_ALLOWED_ACCOUNT_ID\"\]|allowed_kms_accounts = [${ALLOWED_KMS_ACCOUNTS}]|" /out/config.toml; \
    fi

# Re-declare so `config-${BAKE_CONFIG}` resolves; default keeps baked as default.
ARG BAKE_CONFIG=true
FROM config-${BAKE_CONFIG} AS config-src

# ---------------------------------------------------------------------------
# Stage 3: Minimal runtime image for the Nitro Enclave
# ---------------------------------------------------------------------------
# Alpine Linux: ~7 MB base vs ~180 MB for debian:bookworm-slim.
# Busybox provides `ip` (replacing iproute2) and `sed` natively.
# gcompat provides glibc compatibility for the Rust binary.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# Every package this adds is pinned, its dependencies included (#2653): the
# base digest fixes what the image starts from, but `apk add` reads the live
# v3.24 index, so an unpinned package republished there would change the
# runtime layer, and PCR0 with it, between two builds of the same commit — and
# a rebuilt enclave would no longer match the PCR0 its KMS key policy names.
#
# Alpine keeps only the newest build of a package in a release branch, so when
# one of these is updated upstream the build FAILS ("unable to select
# packages") instead of silently picking the new one. That is the intent: PCR0
# moves only with a commit. Take the new versions from
# https://pkgs.alpinelinux.org/packages?branch=v3.24&arch=x86_64 and move the
# pins (and the `FROM` digest, when Dependabot has not) in one PR.
#
# `libc6-compat` used to be listed as well; in Alpine 3.24 it is only a name
# gcompat provides, so pinning gcompat pins it. libssl3 / libcrypto3 (socat,
# ca-certificates) come from the base image at its digest.
RUN apk add --no-cache \
        ca-certificates=20261020-r0 \
        socat=1.8.1.3-r0 \
        readline=8.3.3-r1 \
        libncursesw=6.6_p20260516-r0 \
        ncurses-terminfo-base=6.6_p20260516-r0 \
        jq=1.8.2-r0 \
        oniguruma=6.9.10-r0 \
        gcompat=1.1.0-r4 \
        musl-obstack=1.2.3-r2 \
        libucontext=1.5.1-r0 \
        libgcc=15.2.0-r5 \
    && rm -rf /var/cache/apk/*

# Copy the VTA enclave binary and glibc compat stub
COPY --from=builder /build/target/release/vta-enclave /usr/local/bin/vta-enclave
COPY --from=builder /tmp/libresolv_compat.so /usr/lib/libresolv_compat.so
ENV LD_PRELOAD=/usr/lib/libresolv_compat.so

# Copy the entrypoint script.
# CONFIG (see CONFIG MODES at the top): the config selector below copies
# `/out/config.toml` from the chosen stage — the full tenant config
# (BAKE_CONFIG=true, default) or a fleet-policy base with placeholders
# (BAKE_CONFIG=false). The entrypoint requires a config.toml to be present and
# execs the VTA; in fleet mode the vta-enclave binary (built with the
# `tenant-overlay` feature) fetches the tenant overlay over vsock (port 5800) and
# applies it in-process. See deploy/nitro/enclave-entrypoint.sh and docs.
COPY deploy/nitro/enclave-entrypoint.sh /usr/local/bin/enclave-entrypoint.sh
RUN chmod +x /usr/local/bin/enclave-entrypoint.sh

# Baked config (or nothing) per BAKE_CONFIG — see the config selector stages.
# `/out/` is always a valid source; it holds config.toml only when baking.
COPY --from=config-src /out/ /etc/vta/

# Create data directories
RUN mkdir -p /var/lib/vta

# No HEALTHCHECK. This image only runs as a Nitro Enclave (`nitro-cli
# build-enclave` converts it to an EIF), where no Docker runtime executes one,
# and the VTA serves REST on vsock only (VTA_REST_VSOCK_PORT), so nothing in
# the image could reach /health anyway — the old `wget localhost:8100/health`
# polled a port that no longer exists. Health is checked from the parent:
# `GET /health` through deploy/nitro/enclave-proxy, which is what the load
# balancer's target health check already does. A process-alive probe here
# would be a signal that never goes false.

# Note: USER nobody is not used because the enclave entrypoint needs root
# for `ip link set lo up` and socat vsock proxy setup. The Nitro Enclave
# isolation model provides hardware-level process isolation instead.

# The entrypoint sets up lo, starts vsock proxies, then runs VTA
ENTRYPOINT ["/usr/local/bin/enclave-entrypoint.sh"]
