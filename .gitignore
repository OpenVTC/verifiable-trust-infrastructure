target/
# NOTE: do not add `.git/` here. git never tracks it, so the entry is inert
# for git — but release-plz copies the worktree honouring these rules, and
# excluding `.git` made the copy "not a git repository" (#941).
**data/
**config.toml
!deploy/**/config.toml
**.jsonl
**.vtabak
**.vtcbak

# Sealed-bootstrap test artifacts left in repo roots by local wizard runs
request.json
bootstrap-request.json
*.armor
admin-credential.*

# OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Claude Code agent scratch: screenshots from chrome-devtools MCP,
# scheduled-task lockfile, settings.local.json, ephemeral worktree
# dirs. All operator-local, never checked in.
.claude/

# Secrets and credentials
.env
.env.*

# Downloaded CI job logs. One of these was committed by accident in #888 —
# a `curl -o` in the repo root plus a `git add -A` is all it takes.
*.log

# Captured command output and scratch copies. `*.log` above does not catch
# output saved as `.txt`, and eleven such files plus a `.bak` of a source file
# were committed at the root. `/*.txt` is root-anchored so `.txt` files deeper
# in the tree are unaffected; ci.yml fails if one is tracked at the root anyway.
/*.txt
*.bak
